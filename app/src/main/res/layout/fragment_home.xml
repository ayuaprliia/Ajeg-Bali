<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFAF5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HEADER SECTION (Coklat/Bali) ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_bali">

            <!-- Ornamen batik (background dekoratif) -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ajeg_bali"
                android:alpha="0.12"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Om Swastyastu, Semeton Badung!🙏"
                    android:textColor="#BFBFBF"
                    android:textSize="12sp"
                    android:letterSpacing="0.03" />

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.05"
                    android:text="Ajeg Bali Lens"
                    android:textColor="#FFE0A3"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Kenali &amp; Lestarikan Budaya Bali Melalui Kecerdasan Visual"
                    android:textColor="#B8B0A0"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.5" />

                <!-- Hero Image -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivHeroBanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/img_hero_bali"
                        android:scaleType="centerCrop"
                        android:contentDescription="Ilustrasi budaya Bali" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </FrameLayout>

        <!-- ===== CONTENT AREA ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="@color/ajeg_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fitur\nDeteksi"
                            android:textColor="#9B8070"
                            android:textSize="9sp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI"
                            android:textColor="@color/ajeg_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Computer\nVision"
                            android:textColor="#9B8070"
                            android:textSize="9sp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/book" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Artikel\nBudaya"
                            android:textColor="#9B8070"
                            android:textSize="9sp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Section Label: Pilih Fitur -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PILIH FITUR"
                android:textColor="@color/ajeg_primary"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:layout_marginBottom="12dp"
                android:drawableEnd="@drawable/ic_divider_line"
                android:drawablePadding="8dp"
                android:gravity="center_vertical" />

            <!-- Card Jejahitan -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardJejahitan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <!-- Left accent bar -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_accent_green"
                        android:layout_marginEnd="14dp"/>

                    <!-- Icon -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="12dp"

                        app:cardElevation="0dp"
                        android:layout_marginEnd="14dp">
                        <!-- Ganti CardView yang berisi TextView emotikon menjadi: -->
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/jejahitan_button"
                            android:scaleType="fitCenter" />
                    </androidx.cardview.widget.CardView>

                    <!-- Text -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Klasifikasi Jejahitan"
                            android:textColor="#2C1A0E"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kenali jenis jejahitan Bali dalam berbagai upacara"
                            android:textColor="#8B6F55"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#C4A882"
                        android:textSize="22sp"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Ketupat -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardKetupat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_accent_orange"
                        android:layout_marginEnd="14dp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="14dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ketupat_button"
                            android:scaleType="fitCenter" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Klasifikasi Ketupat"
                            android:textColor="#2C1A0E"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kenali berbagai bentuk ketupat khas tradisi Bali"
                            android:textColor="#8B6F55"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#C4A882"
                        android:textSize="22sp"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Wayang -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWayang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_accent_purple"
                        android:layout_marginEnd="14dp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="14dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/wayang_button"
                            android:scaleType="fitCenter" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deteksi Wayang"
                            android:textColor="#2C1A0E"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kenali tokoh Wayang Kulit Bali dari gambar"
                            android:textColor="#8B6F55"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#C4A882"
                        android:textSize="22sp"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quote Band -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quote_band"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪷"
                    android:textSize="20sp"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&quot;Ajeg Bali&quot; — menjaga, merawat, dan melestarikan budaya Bali untuk generasi mendatang."
                        android:textColor="#D4C0A0"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:lineSpacingMultiplier="1.5"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— Misi Ajeg Bali Lens"
                        android:textColor="#8B7A65"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Info Strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_strip"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="top">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="15sp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="1dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Penggunaan"
                        android:textColor="#6B4C1E"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih fitur di atas, arahkan kamera ke objek budaya Bali, lalu tap tombol scan untuk memulai identifikasi."
                        android:textColor="#8B6A40"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>