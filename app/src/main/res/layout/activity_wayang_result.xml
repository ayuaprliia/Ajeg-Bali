<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Judul Halaman -->
        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hasil Deteksi Wayang"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#8F9E8B"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <!-- Card Gambar Hasil Deteksi (dengan Bounding Box) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgResult"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:adjustViewBounds="true" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="#8F9E8B" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Info Deteksi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Objek Terdeteksi:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtPrediction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menganalisis..."
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#8F9E8B"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtInferenceTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waktu komputasi: 0 ms"
                android:textSize="12sp"
                android:textColor="#888888"
                android:textStyle="italic"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- Container DINAMIS untuk informasi semua karakter terdeteksi -->
        <!-- Card akan ditambahkan secara programatis di sini -->
        <LinearLayout
            android:id="@+id/containerCharacterInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Pesan jika tidak terdeteksi -->
        <TextView
            android:id="@+id/txtNoDetection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tidak ada wayang yang terdeteksi.\nCoba foto dari sudut atau jarak yang berbeda."
            android:textSize="14sp"
            android:textColor="#666666"
            android:textAlignment="center"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <!-- Tombol Kembali -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Kenali Objek Lain"
            android:backgroundTint="#8F9E8B"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
