<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F0E6"
    tools:context=".SplashActivity">

    <!-- Ornamen sudut (4 sudut) -->
    <ImageView
        android:id="@+id/ivCornerTopLeft"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/ornament_corner"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivCornerTopRight"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/ornament_corner"
        android:scaleType="fitXY"
        android:scaleX="-1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivCornerBottomLeft"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/ornament_corner"
        android:scaleType="fitXY"
        android:scaleY="-1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivCornerBottomRight"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/ornament_corner"
        android:scaleType="fitXY"
        android:scaleX="-1"
        android:scaleY="-1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- Konten tengah -->
    <LinearLayout
        android:id="@+id/layoutCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo -->

        <!-- Garis tipis di atas judul -->

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:background="@drawable/logo_circle_bg"
            android:src="@drawable/ajeg_bali" />

        <View
            android:layout_width="80dp"
            android:layout_height="0.8dp"
            android:background="#C49A3C"
            android:alpha="0.4"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <!-- Judul -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajeg Bali Lens"
            android:textColor="#2C1A0E"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:gravity="center" />

        <!-- Ornamen diamond antara judul dan tagline -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="44dp"
                android:layout_height="0.8dp"
                android:background="#C49A3C"
                android:alpha="0.6" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_diamond"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <View
                android:layout_width="44dp"
                android:layout_height="0.8dp"
                android:background="#C49A3C"
                android:alpha="0.6" />

        </LinearLayout>

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="229dp"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:lineSpacingMultiplier="1.6"
            android:text="Lestarikan Budaya Melalui Kecerdasan Visual"
            android:textAlignment="center"
            android:textColor="#7A5C2E"
            android:textSize="11.5sp" />

    </LinearLayout>


    <!-- Ornamen horizontal bawah (mirror) -->
    <ImageView
        android:id="@+id/ivOrnamentBottom"
        android:layout_width="200dp"
        android:layout_height="12dp"
        android:src="@drawable/ornament_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutCenter"
        android:layout_marginTop="40dp" />

    <!-- Versi -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v 1.0.0"
        android:textColor="#B0936A"
        android:textSize="10sp"
        android:letterSpacing="0.15"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>