<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lingkaran luar -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#EDE3D3"/>
            <stroke android:width="1.2dp" android:color="#C49A3C"/>
            <size android:width="144dp" android:height="144dp"/>
        </shape>
    </item>
    <!-- Lingkaran dalam halus -->
    <item android:left="8dp" android:top="8dp"
        android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="0.5dp" android:color="#C49A3C"/>
        </shape>
    </item>
</layer-list>